rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function canClearRemovedPlayerActiveRoom(userId) {
      return request.auth.uid != userId
        && resource.data.activeRoomId is string
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["activeRoomId"])
        && request.resource.data.activeRoomId == null
        && !existsAfter(/databases/$(database)/documents/rooms/$(resource.data.activeRoomId)/players/$(userId));
    }

    function roomAfterWithinCapacity() {
      return existsAfter(/databases/$(database)/documents/rooms/main)
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount is int
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount >= 0
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount <= 19;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;
      allow update: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && (
              (
                request.resource.data.displayName is string
                && request.resource.data.displayName.size() > 0
              ) || (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(["activeRoomId"])
              )
            )
          ) || canClearRemovedPlayerActiveRoom(userId)
        );
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && roomId == "main";
      allow create: if isSignedIn() && roomId == "main";
      allow update: if isSignedIn()
        && roomId == "main"
        && roomAfterWithinCapacity()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.state in ["waiting", "playing"]
        && !request.resource.data.keys().hasAny(["hostUid"])
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["playerCount", "lastActiveAt", "waitingSince", "state",
                    "marcoCount", "rounds",
                    "gamePhase", "currentRound", "eliminatedPlayerIds",
                    "investigatedPlayerIds", "usedThemes", "winner"]);
      allow delete: if false;

      match /players/{playerId} {
        allow read: if isSignedIn() && roomId == "main";
        allow create: if isSignedIn()
          && roomId == "main"
          && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(["name", "isReady", "votekickCount", "joinedAt", "lastSeenAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.isReady is bool
          && request.resource.data.votekickCount is int
          && request.resource.data.votekickCount == 0
          && roomAfterWithinCapacity();
        allow update: if isSignedIn()
          && roomId == "main"
          && (
            (
              request.auth.uid == playerId
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["name", "isReady", "lastSeenAt"])
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.isReady is bool
            )
            || (
              request.auth.uid != playerId
              && roomAfterWithinCapacity()
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["votekickCount"])
              && request.resource.data.votekickCount is int
              && request.resource.data.votekickCount == ((resource.data.votekickCount is int ? resource.data.votekickCount : 0) + 1)
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)/votes/$(request.auth.uid))
            )
            || (
              request.resource.data.diff(resource.data).changedKeys().hasOnly(["role"])
              && request.resource.data.role in ["Marco", "Reg"]
              && getAfter(/databases/$(database)/documents/rooms/main).data.state == "playing"
            )
          );
        allow delete: if isSignedIn()
          && roomId == "main"
          && (
            request.auth.uid == playerId
            || (
              request.auth.uid != playerId
              && resource.data.votekickCount is int
              && resource.data.votekickCount >= 2
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)/votes/$(request.auth.uid))
            )
          );

        match /votes/{voterUid} {
          allow read: if isSignedIn() && roomId == "main";
          allow create: if isSignedIn()
            && roomId == "main"
            && request.auth.uid == voterUid
            && request.resource.data.voterUid == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /rounds/{roundNum} {
        allow read: if isSignedIn() && roomId == "main";
        allow create: if isSignedIn() && roomId == "main";
        allow update: if isSignedIn()
          && roomId == "main"
          && (
            // startGame resets an existing round doc for a new game
            (
              getAfter(/databases/$(database)/documents/rooms/main).data.state == "playing"
              && getAfter(/databases/$(database)/documents/rooms/main).data.gamePhase == "round-upload"
            )
            // Any player can submit their own photo to the submissions map
            || request.resource.data.diff(resource.data).changedKeys().hasOnly(["submissions"])
            || (
              // Marco submits/overrides elimination target
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["marcoSubmission", "marcoConfirmed"])
            )
            || (
              // Additional Marcos confirm the proposal
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["marcoConfirmed"])
            )
            || (
              // Eliminated player chooses clue word
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["selectedClue"])
            )
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["advanceToInvestigation"])
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["investigationVotes"])
            || (
              // Any player can advance upload → elimination once all submissions are in.
              // "action" is the legacy roundPhase name used by the old Cloud Function (same as "upload").
              resource.data.roundPhase in ["upload", "action"]
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["roundPhase"])
              && request.resource.data.roundPhase == "elimination"
            )
            || (
              // Client-side fallback: elimination → clue (also sets eliminatedPlayerId)
              resource.data.roundPhase == "elimination"
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["roundPhase", "eliminatedPlayerId"])
              && request.resource.data.roundPhase == "clue"
            )
            || (
              // Client-side fallback: clue → reveal
              resource.data.roundPhase == "clue"
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["roundPhase"])
              && request.resource.data.roundPhase == "reveal"
            )
            || (
              // Client-side fallback: reveal → vote
              resource.data.roundPhase == "reveal"
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["roundPhase"])
              && request.resource.data.roundPhase == "vote"
            )
            || (
              // Client-side fallback: vote → done (also sets investigatedPlayerId)
              resource.data.roundPhase == "vote"
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["roundPhase", "investigatedPlayerId"])
              && request.resource.data.roundPhase == "done"
            )
            || (
              // Client-side: patch missing theme/clueOptions on round created by old CF
              resource.data.roundPhase in ["action", "upload"]
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["theme", "clueOptions"])
            )
          );

        // Private subcollection — written by client-side fallback when Cloud Functions are not deployed.
        // create AND update are both needed because a leftover doc from a previous run triggers
        // an overwrite which Firestore evaluates as an update, not a create.
        match /private/{docId} {
          allow read: if isSignedIn()
            && roomId == "main"
            && resource.data.forPlayerId == request.auth.uid;
          allow create, update: if isSignedIn() && roomId == "main";
          allow delete: if false;
        }
      }
    }

    match /stats/{docId} {
      allow read, write: if false;
    }
  }
}
