rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn()
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName is string
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName.size() > 0
          ) || (
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName is string
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName.size() > 0
          )
        );
    }

    function canClearRemovedPlayerActiveRoom(userId) {
      return request.auth.uid != userId
        && resource.data.activeRoomId is string
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["activeRoomId"])
        && request.resource.data.activeRoomId == null
        && !existsAfter(/databases/$(database)/documents/rooms/$(resource.data.activeRoomId)/players/$(userId));
    }

    function roomAfterWithinCapacity() {
      return existsAfter(/databases/$(database)/documents/rooms/main)
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount is int
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount >= 0
        && getAfter(/databases/$(database)/documents/rooms/main).data.playerCount <= 19;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;
      allow update: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && (
              (
                request.resource.data.displayName is string
                && request.resource.data.displayName.size() > 0
              ) || (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(["activeRoomId"])
              )
            )
          ) || canClearRemovedPlayerActiveRoom(userId)
        );
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && roomId == "main";
      allow create: if isSignedIn() && roomId == "main";
      allow update: if isSignedIn()
        && roomId == "main"
        && roomAfterWithinCapacity()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.state in ["waiting", "playing"]
        && !request.resource.data.keys().hasAny(["hostUid"])
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["playerCount", "lastActiveAt", "waitingSince", "state",
                    "marcoCount", "rounds", "photosPerPlayer",
                    "gamePhase", "currentRound", "eliminatedPlayerIds",
                    "investigatedPlayerIds", "winner"]);
      allow delete: if false;

      match /players/{playerId} {
        allow read: if isSignedIn() && roomId == "main";
        allow create: if isSignedIn()
          && roomId == "main"
          && request.auth.uid == playerId
          && request.resource.data.keys().hasOnly(["name", "isReady", "votekickCount", "joinedAt", "lastSeenAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.isReady is bool
          && request.resource.data.votekickCount is int
          && request.resource.data.votekickCount == 0
          && roomAfterWithinCapacity();
        allow update: if isSignedIn()
          && roomId == "main"
          && (
            (
              request.auth.uid == playerId
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["name", "isReady", "lastSeenAt"])
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.isReady is bool
            )
            || (
              request.auth.uid == playerId
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["photoUrls", "usedPhotoUrls", "hasUploadedPhotos"])
            )
            || (
              request.auth.uid == playerId
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["usedPhotoUrls"])
            )
            || (
              request.auth.uid != playerId
              && roomAfterWithinCapacity()
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(["votekickCount"])
              && request.resource.data.votekickCount is int
              && request.resource.data.votekickCount == ((resource.data.votekickCount is int ? resource.data.votekickCount : 0) + 1)
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)/votes/$(request.auth.uid))
            )
            || (
              request.resource.data.diff(resource.data).changedKeys().hasOnly(["role"])
              && request.resource.data.role in ["Marco", "Reg"]
              && getAfter(/databases/$(database)/documents/rooms/main).data.state == "playing"
            )
          );
        allow delete: if isSignedIn()
          && roomId == "main"
          && (
            request.auth.uid == playerId
            || (
              request.auth.uid != playerId
              && resource.data.votekickCount is int
              && resource.data.votekickCount >= 2
              && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(playerId)/votes/$(request.auth.uid))
            )
          );

        match /votes/{voterUid} {
          allow read: if isSignedIn() && roomId == "main";
          allow create: if isSignedIn()
            && roomId == "main"
            && request.auth.uid == voterUid
            && request.resource.data.voterUid == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /rounds/{roundNum} {
        allow read: if isSignedIn() && roomId == "main";
        allow create: if isSignedIn() && roomId == "main";
        allow update: if isSignedIn()
          && roomId == "main"
          && (
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["marcoSubmissions", "marcoConfirmed"])
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["publicPhotoUrls"])
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["eliminatedClue"])
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["advanceToInvestigation"])
            || request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["investigationVotes"])
          );
      }
    }

    match /stats/{docId} {
      allow read, write: if false;
    }
  }
}
