rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /marcophotos/{roomId}/{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /marcophotos/{roomId}/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /marcophotos/{roomId}/rounds/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
